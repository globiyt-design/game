import pygame

WIDTH = 800
HEIGHT = 600
FPS = 60

BG_COLOR = (20, 24, 33)     
RED = (255, 50, 50)          
WHITE = (255, 255, 255)      

pygame.init()
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("OUTLAW: Response Level")
clock = pygame.time.Clock()

font = pygame.font.SysFont("Arial", 28, bold=True)


wanted_level = 1  

running = True
while running:
    clock.tick(FPS)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill(BG_COLOR)
    
    warning_text = "WANTED LEVEL: " + "!" * wanted_level
    text_surface = font.render(warning_text, True, RED)
    screen.blit(text_surface, (20, 20))

    pygame.display.update()

pygame.quit()
